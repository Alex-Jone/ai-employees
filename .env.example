# ==== Confluence MCP (可选) ====
# 只有当你需要通过 MCP 读取自建 Confluence 时才配置
# 若留空则 Confluence MCP 服务不会启动
CONFLUENCE_BASE_URL=
CONFLUENCE_TOKEN=

# ==== 摘要存储数据库 (可选) ====
# 用于持久化对话摘要,如不使用可留空或注释掉整块
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_employees

# ==== DeepSeek Provider (可选) ====
# 若要启用 deepseek provider,需要配置 API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ==== 元数据仓库直连 (可选) ====
# 用于 category=utility 且带 dbConnection 的员工
METABASE_HOST=
METABASE_PORT=9030
METABASE_USER=
METABASE_PASSWORD=
METABASE_DB=

# ==== 服务端口 ====
PORT=3000
